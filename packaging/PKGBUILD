# Local-source PKGBUILD: the parent repo checkout is the source.
# From packaging/ in a normal terminal: mise exec -- makepkg -si -d
# mise supplies cargo; -d skips pacman's makedepends check so no second system
# Rust is installed. gtk4 is already present. makepkg asks for sudo only at install.
# Background sync (optional): systemctl --user enable --now nv-linux-sync

pkgname=nv-linux
pkgver=0.2.0
pkgrel=1
pkgdesc='Notational Velocity for Omarchy: search-or-create plain-text notes'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('gtk4' 'glib2' 'glibc' 'gcc-libs' 'dbus')
optdepends=('gnome-keyring: store the Dropbox sign-in in the desktop keyring')
makedepends=('cargo')
options=('!debug' '!lto')  # makepkg's -flto C objects (ring) can't link with rust-lld

build() {
  cd "$startdir/.."
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked -p nv-app
}

package() {
  cd "$startdir/.."
  install -Dm755 "$srcdir/target/release/nv-linux" "$pkgdir/usr/bin/nv-linux"
  install -Dm644 "packaging/nv-linux.desktop" "$pkgdir/usr/share/applications/nv-linux.desktop"
  install -Dm644 "packaging/nv-linux.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/nv-linux.svg"
  install -Dm644 "packaging/nv-linux-sync.service" "$pkgdir/usr/lib/systemd/user/nv-linux-sync.service"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/nv-linux/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/nv-linux/LICENSE"
}
